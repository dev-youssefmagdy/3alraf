# /etc/systemd/system/3alraf-mcp.service
# Secrets live in /etc/3alraf-mcp.env (root:root, mode 600), never in this file.
[Unit]
Description=3alraf MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/var/www/3alraf/mcp-server
EnvironmentFile=/etc/3alraf-mcp.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

# Creates /var/lib/3alraf-mcp for MCP_OAUTH_STATE_FILE
StateDirectory=3alraf-mcp
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
