# 3alraf MCP server. Copy to .env for local use; in production use /etc/3alraf-mcp.env (mode 600).

# --- Listener ---
MCP_HOST=127.0.0.1
MCP_PORT=8787
# Public origin (no path). Required for OAuth; the MCP URL is this + /mcp.
MCP_PUBLIC_URL=https://mcp.3alraf.com
# Optional comma-separated Host header allowlist. Default: the public hostname, 127.0.0.1, localhost.
#MCP_ALLOWED_HOSTS=mcp.3alraf.com,127.0.0.1,localhost

# --- Auth: at least one of the two must be configured ---
# Static bearer (Claude Code, API clients, or Claude "Request headers" where your account has that beta).
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# OAuth for Claude's custom connector (see README). The owner password is typed on the consent page.
MCP_OAUTH_ENABLED=true
# Generate with: openssl rand -base64 24   (at least 16 characters)
MCP_OAUTH_OWNER_PASSWORD=
# Keeps connector sign-ins across restarts. Holds token hashes only. Leave empty for memory only.
MCP_OAUTH_STATE_FILE=/var/lib/3alraf-mcp/oauth-state.json
# Exact callback URLs a client may register, comma separated.
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
MCP_OAUTH_ACCESS_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TTL_DAYS=30

# --- Limits ---
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_BODY_LIMIT=1mb

# --- Laravel marketing API ---
LARAVEL_BASE_URL=https://3alraf.com
# Service token from Marketer panel > Marketing API tokens. Scopes: marketing:read, the suggestions:write:* scopes you want Claude to use (all 10 for full use), meta:read, meta:draft
LARAVEL_SERVICE_TOKEN=
LARAVEL_TIMEOUT_MS=20000
LARAVEL_GET_RETRIES=2
LARAVEL_RETRY_BASE_MS=300
# Base of the review links handed to the owner. Default: LARAVEL_BASE_URL.
#MARKETER_PANEL_URL=https://3alraf.com

LOG_LEVEL=info
