WA_PORT=3100
WA_HOST=127.0.0.1
WA_API_TOKEN=            # same value as WHATSAPP_SERVICE_TOKEN in Laravel
WA_CALLBACK_SECRET=      # same value as WHATSAPP_CALLBACK_SECRET in Laravel
WA_CALLBACK_URL=https://APP_HOST/internal/whatsapp/events   # APP_URL host of the Laravel app
WA_AUTH_DIR=/var/lib/3alraf-whatsapp   # persistent, 0700, owned by the service user (never /tmp)
WA_ENCRYPTION_KEY=       # base64 of 32 random bytes: openssl rand -base64 32  (losing it = the session must re-scan)
