# FreeLLMAPI container settings. Copy to /opt/freellmapi/.env and chmod 600.
# REQUIRED. Encrypts the provider API keys stored in the data volume. Generate once: openssl rand -hex 32
# Keep it with your backups: without it the stored keys cannot be decrypted.
ENCRYPTION_KEY=

# Port inside the container (the compose file publishes it on 127.0.0.1:3001 only)
PORT=3001

# Behind nginx on llm.3alraf.com (deploy/freellmapi/nginx): trust one proxy hop for client IPs (rate limits, logs)
TRUST_PROXY=1
# DNS-rebinding guard: Host names the server answers to (loopback is always allowed, so Laravel on 127.0.0.1 keeps working)
ALLOWED_HOSTS=llm.3alraf.com

# Optional: pin an image tag instead of latest (see https://github.com/tashfeenahmed/freellmapi/pkgs/container/freellmapi)
# FREELLMAPI_TAG=latest
