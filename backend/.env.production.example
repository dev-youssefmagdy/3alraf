# Production overrides (merge into .env). Only media/CDN keys shown here.
APP_URL=https://domain.com

# Option A: local directory served by the static cdn vhost (docs/cdn-nginx.conf)
MEDIA_DRIVER=local
MEDIA_ROOT=/var/www/cdn/media
MEDIA_URL=https://cdn.domain.com

# Option B: S3-compatible (Cloudflare R2 / MinIO / S3)
# MEDIA_DRIVER=s3
# MEDIA_KEY=
# MEDIA_SECRET=
# MEDIA_BUCKET=3alraf-media
# MEDIA_REGION=auto
# MEDIA_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MEDIA_PATH_STYLE=true
# MEDIA_URL=https://cdn.domain.com

MEDIA_DISK=media
MEDIA_PRIVATE_DISK=private   # storage/app/private, never web-served
MEDIA_SIGNED_TTL=10
