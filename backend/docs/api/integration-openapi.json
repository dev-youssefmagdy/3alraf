{
  "openapi": "3.0.3",
  "info": {
    "title": "3alraf Growth Integration API (n8n)",
    "version": "1.0.0",
    "description": "Server-to-server API. Auth: Authorization Bearer token + X-Timestamp (unix s, +-300s) + X-Signature = hex HMAC-SHA256(client secret, \"{timestamp}.{raw body}\"). Optional IP allowlist (GROWTH_INTEGRATION_IPS). No endpoint can change prices, refunds, stock or ad budgets. Each endpoint is also gated by the tenant's per-feature switch (403 feature_disabled). Webhook events from Laravel use the same signature scheme (X-Event-Id, X-Event-Type headers)."
  },
  "servers": [
    {
      "url": "https://{host}/api/integration/v1",
      "variables": {
        "host": {
          "default": "shop.example.com"
        }
      }
    }
  ],
  "paths": {
    "/approvals/{id}": {
      "get": {
        "operationId": "approvals.show",
        "summary": "Scope: read; feature: approvals",
        "security": [
          {
            "bearerAuth": [],
            "hmacSignature": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "unauthenticated (bad token, signature or stale timestamp)"
          },
          "403": {
            "description": "growth_disabled | feature_disabled | forbidden_scope | ip_not_allowed"
          },
          "422": {
            "description": "validation"
          },
          "429": {
            "description": "too_many_requests"
          }
        }
      }
    },
