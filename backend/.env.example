APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_CENTRAL_DOMAIN=3alraf.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Comma list of trusted proxy IPs/CIDRs (default private ranges), or * to trust all
# TRUSTED_PROXIES=

# Media / CDN (public images) and private files
MEDIA_DISK=media

# Soft-deleted records older than this are purged/anonymised daily (retention:purge)
SOFT_DELETE_RETENTION_DAYS=60
MEDIA_URL=http://localhost:8000/media
MEDIA_PRIVATE_DISK=private
MEDIA_SIGNED_TTL=10

# Sign in / register with Google (leave empty to disable). One platform OAuth client for every store.
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web application):
#   Authorized redirect URI (exactly, once): https://APP_CENTRAL_DOMAIN/auth/google/callback
# GOOGLE_MOBILE_CLIENT_IDS = extra client ids (Android/iOS) accepted as ID-token audience by POST /api/v1/auth/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_IDS=

# Real-time admin notifications (Reverb server runs separately: deploy/reverb). Set BROADCAST_CONNECTION=reverb to enable.
REVERB_APP_ID=3alraf
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.3alraf.loc
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
