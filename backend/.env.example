# Only bootstrap values live here. Everything else (APP_URL, APP_DEBUG, locales, media, Google, WhatsApp, Reverb, Meta...)
# is edited in Admin > System settings (stored in the `settings` table; run `php artisan migrate`).
APP_ENV=local
APP_KEY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=2628000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Search by image (config/image_search.php): local embedder service (image-embedder/, 127.0.0.1 only) + queue `embeddings`
IMAGE_EMBEDDER_URL=http://127.0.0.1:8090
IMAGE_SEARCH_AUTO_INDEX=true

# Product AI tools (config/product_ai.php, docs/FREELLMAPI_SETUP.md). Normally set in Admin > System settings > AI
# (stored encrypted in `settings`); these are only the defaults / first import. Configured = base URL AND key set.
# Same VPS as FreeLLMAPI: http://127.0.0.1:3001/v1 (no TLS hop). Laravel on another server: https://llm.3alraf.com/v1
# FREELLM_BASE_URL=http://127.0.0.1:3001/v1
# FREELLM_API_KEY=
# Ordered fallback lists: on 429 / 5xx / timeout / no_vision_model the next model is tried
# FREELLM_TEXT_MODELS=auto,auto:reliable,auto:fast
# FREELLM_VISION_MODELS=auto,gemini-2.5-flash
# FREELLM_TIMEOUT=40
# FREELLM_COOLDOWN=60
# PRODUCT_AI_SEARCH_BACKENDS=google,bing,duckduckgo
# PRODUCT_AI_SEARCH_REGION=eg-ar
# PRODUCT_AI_MARKET_COUNTRY=EG
# PRODUCT_AI_CURRENCY=EGP
# PRODUCT_AI_MARKETPLACES=amazon.eg,noon.com,jumia.com.eg,btech.com,2b.com.eg,rayashop.com,carrefouregypt.com,dream2000.com
# PRODUCT_AI_CACHE_HOURS=24
# PRODUCT_AI_THROTTLE=10
# PRODUCT_AI_MAX_PAGE_FETCHES=8
# PRODUCT_AI_FREELLM_SEARCH=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Store"

# Comma list of trusted proxy IPs/CIDRs (default private ranges), or * to trust all
# TRUSTED_PROXIES=
