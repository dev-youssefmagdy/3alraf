# n8n for 3alraf — copy to .env (gitignored, chmod 600). Loaded by start.sh (shell syntax: KEY=value, single-quote JSON).
# Local: n8n.3alraf.loc behind Apache (backend/deploy/apache/000-n8n.3alraf.loc.conf).
# Production (n8n.3alraf.com behind nginx + TLS): see the "Production" block at the end and README.md.

# --- where n8n lives ---
N8N_USER_FOLDER=/var/www/3alraf/n8n/data
N8N_HOST=n8n.3alraf.loc
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n.3alraf.loc/
N8N_EDITOR_BASE_URL=http://n8n.3alraf.loc/
# exactly one reverse proxy (Apache locally, nginx in prod) sets X-Forwarded-*
N8N_PROXY_HOPS=1
# false ONLY locally (plain http). Production: true (https).
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Africa/Cairo
TZ=Africa/Cairo

# --- security ---
# generate once: openssl rand -hex 32  — NEVER change it afterwards (credentials are encrypted with it); back it up with data/.
N8N_ENCRYPTION_KEY=change-me
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=true
# nodes that run shell commands / watch the filesystem are not needed by any 3alraf workflow
NODES_EXCLUDE='["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger","n8n-nodes-base.ssh"]'
N8N_RESTRICT_FILE_ACCESS_TO=/var/www/3alraf/n8n/data/files
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# --- Code node / task runners (recommended for n8n >= 1.x, default in 2.x) ---
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
# the signing Code node needs crypto (HMAC-SHA256); nothing else is allowed
NODE_FUNCTION_ALLOW_BUILTIN=crypto
NODE_FUNCTION_ALLOW_EXTERNAL=
# The 3alraf workflows read THREEALRAF_* / NOTIFY_* via $env (HMAC secret + base URLs). n8n 2.x blocks $env by default;
# this instance is single-owner, so it is opened here. See README "How workflows authenticate".
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Expression engine: 1.123.x defaults to "vm" (isolated-vm, which needs Node >= 22 — stubbed here, see README).
# "legacy" is the classic, fully supported engine. REQUIRED on Node 20.
N8N_EXPRESSION_ENGINE=legacy

# --- database / executions ---
DB_TYPE=sqlite
DB_SQLITE_POOL_SIZE=2
DB_SQLITE_VACUUM_ON_STARTUP=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console,file
N8N_LOG_FILE_LOCATION=/var/www/3alraf/n8n/data/logs/n8n.log

# --- 3alraf integration API (/api/integration/v1) used by the workflows ---
THREEALRAF_API_BASE=http://3alraf.loc/api/integration/v1
THREEALRAF_SITE_URL=http://3alraf.loc
# HMAC secret of the integration client (bearer token lives in the n8n credential "3alraf integration (bearer)").
# Written by ./provision-client.sh — do not edit by hand.
THREEALRAF_HMAC_SECRET=

# --- owner notifications (workflow "90 - Notify owner") ---
# Always: message in the execution output. Optional: POST JSON {title,text,level,source} to a webhook
# (e.g. the WhatsApp gateway in whatsapp-service/ or a Telegram bot relay). Empty = off.
NOTIFY_WEBHOOK_URL=
# Optional e-mail: set true, then create an SMTP credential in n8n and enable the "Send email" node.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_TO=owner@3alraf.loc
NOTIFY_EMAIL_FROM=n8n@3alraf.loc

# --- Production (n8n.3alraf.com) — differences only ---
# N8N_HOST=n8n.3alraf.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.3alraf.com/
# N8N_EDITOR_BASE_URL=https://n8n.3alraf.com/
# N8N_SECURE_COOKIE=true
# N8N_USER_FOLDER=/var/lib/n8n
# N8N_RESTRICT_FILE_ACCESS_TO=/var/lib/n8n/files
# N8N_LOG_FILE_LOCATION=/var/log/n8n/n8n.log
# THREEALRAF_API_BASE=https://3alraf.com/api/integration/v1
# THREEALRAF_SITE_URL=https://3alraf.com
