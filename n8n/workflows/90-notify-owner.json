{
  "id": "3alrafNotifyOw90",
  "name": "90 - Notify owner (sub-workflow)",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "3bee89ff-5f7c-5844-9dbb-a0b0e8a2da29",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Owner notification. Input items: { title, text, level: info|warning|error, source, link? }.\n// Always: the formatted message is this execution's output (Executions list in n8n).\n// Optional: NOTIFY_WEBHOOK_URL (POST JSON) and NOTIFY_EMAIL_ENABLED=true + the \"Send email\" node (enable it, pick an SMTP credential).\nconst prefix = { info: '[3alraf]', warning: '[3alraf][تنبيه]', error: '[3alraf][خطأ]' };\nreturn $input.all().map((item) => {\n  const j = item.json || {};\n  const level = ['info', 'warning', 'error'].includes(j.level) ? j.level : 'info';\n  const title = String(j.title || 'إشعار');\n  const text = String(j.text || '');\n  const message = `${prefix[level]} ${title}\\n\\n${text}` + (j.link ? `\\n\\n${j.link}` : '');\n  return { json: {\n    title, text, level, source: j.source || 'unknown', link: j.link || null, message, sent_at: new Date().toISOString(),\n    channels: { execution_output: true, webhook: !!$env.NOTIFY_WEBHOOK_URL, email: String($env.NOTIFY_EMAIL_ENABLED || '') === 'true' },\n    webhook_url: String($env.NOTIFY_WEBHOOK_URL || ''),\n    email_to: String($env.NOTIFY_EMAIL_TO || ''), email_from: String($env.NOTIFY_EMAIL_FROM || ''),\n  } };\n});\n"
      },
      "id": "7749ddce-76f0-58bd-9c65-0ccb5fd09bb4",
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "32a0feab-1c32-5a85-9baa-6cf7c9ecd6d2",
              "leftValue": "={{ $json.channels.webhook }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "72c0cb5e-74de-5bd3-b751-be0bfc1661ed",
      "name": "Webhook configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
